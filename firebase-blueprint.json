{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store item catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "shortDescription": { "type": "string", "maxLength": 500 },
        "price": { "type": "number" },
        "compareAtPrice": { "type": "number" },
        "currency": { "type": "string" },
        "categoryId": { "type": "string" },
        "stock": { "type": "number" },
        "sku": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "images": { "type": "array" },
        "variants": { "type": "array" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "slug", "price"]
    },
    "Category": {
      "title": "Category",
      "description": "Product collection category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "image": { "type": "string" },
        "productCount": { "type": "number" }
      },
      "required": ["id", "name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentReceiptUrl": { "type": "string" },
        "status": { "type": "string" },
        "deliveryAddress": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "customerName", "customerPhone", "items", "total", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "avatar": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "TelegramSource": {
      "title": "TelegramSource",
      "description": "Connected Telegram channel source",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "channelUsername": { "type": "string" },
        "channelTitle": { "type": "string" },
        "avatar": { "type": "string" },
        "enabled": { "type": "boolean" },
        "lastScrapedAt": { "type": "string" },
        "lastMessageId": { "type": "number" },
        "importedCount": { "type": "number" }
      },
      "required": ["id", "channelUsername"]
    },
    "TelegramDraft": {
      "title": "TelegramDraft",
      "description": "Scraped product draft waiting for ingestion",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "channel": { "type": "string" },
        "messageId": { "type": "number" },
        "rawPostUrl": { "type": "string" },
        "parsedData": { "type": "object" },
        "images": { "type": "array" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "channel", "messageId", "parsedData"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Product collection items"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Product categories"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders and payment records"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and permissions"
    },
    "/telegramSources/{sourceId}": {
      "schema": { "$ref": "#/entities/TelegramSource" },
      "description": "Admin configured Telegram ingestion channels"
    },
    "/telegramDrafts/{draftId}": {
      "schema": { "$ref": "#/entities/TelegramDraft" },
      "description": "Scraped Telegram post drafts"
    }
  }
}
